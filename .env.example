# =============================================================================
# DV SAUDE — VARIAVEIS DE AMBIENTE
# Copie para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.
# Gere SECRET_KEY com: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# Seguranca
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
SESSION_COOKIE_SECURE=true
DOMAIN=seu-dominio.example.com

# Primeiro administrador. Use uma senha aleatoria e troque-a apos o primeiro acesso.
ADMIN_USUARIO=admin
ADMIN_NOME=Administrador
ADMIN_SENHA=DEFINA_UMA_SENHA_FORTE_AQUI

# Super Admin comercial da DCA Software (opcional, sem credenciais padrão).
# Preencha os três valores com um login novo e exclusivo para a área comercial.
# Não reutilize a conta ADMIN clínica nem compartilhe este acesso com clientes.
DCA_SUPER_ADMIN_USER=
DCA_SUPER_ADMIN_NAME=
DCA_SUPER_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_SUPER_ADMIN_PASSWORD

# Banco de dados (SQLite para dev local, PostgreSQL para producao)
# Dev local:
# DV_DATABASE_PATH=dv_odonto.db
# Producao:
DATABASE_URL=postgresql://dvapp:GERE_OUTRA_CHAVE_HEX_DE_64_CHARS@db:5432/dv_odonto

# PostgreSQL (usado pelo servico db no Docker)
POSTGRES_DB=dv_odonto
POSTGRES_USER=dvuser
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_APP_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:GERE_OUTROS_64_CHARS_HEX@redis:6379/0
RATELIMIT_STORAGE_URL=redis://:GERE_OUTROS_64_CHARS_HEX@redis:6379/1

# Servidor
PORT=8000
FLASK_ENV=production

# Pool de conexoes PostgreSQL
DB_POOL_MIN=1
DB_POOL_MAX=8

# Backup
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_AGE_RECIPIENT=age1cole_se_a_chave_publica_gerada_para_o_servidor
# Grafana
GRAFANA_ADMIN_USER=dvadmin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD
